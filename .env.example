# Pick "mock" (default — free, deterministic) or "openai" (real LLM, costs $).
LLM_PROVIDER=mock

# Sizing knobs
MAX_CRITIC_TOKENS=1500
MAX_SUPERVISOR_TOKENS=4000
MAX_CROSS_CHALLENGE_ROUNDS=2
TIMEOUT_SECONDS=120

# ---- OpenAI (only used when LLM_PROVIDER=openai) ----
# Required:
# OPENAI_API_KEY=
# Optional:
# OPENAI_BASE_URL=https://your-proxy.example/v1     # OpenAI-compatible gateway
# OPENAI_ORGANIZATION=org-...
# OPENAI_CRITIC_MODEL=gpt-4o-mini                   # default
# OPENAI_SUPERVISOR_MODEL=gpt-4o                    # default

# ---- Azure OpenAI (set these instead of OPENAI_BASE_URL) ----
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment      # this overrides `model`
# AZURE_OPENAI_API_VERSION=2024-10-21               # optional

# Day 9 auto-distill — keep OFF until a worker queue lands (debt D-11).
DISABLE_AUTO_DISTILL=1
